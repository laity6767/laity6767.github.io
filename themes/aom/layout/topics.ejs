<div class="container columns"><section><h1 class="page-title"><%= page.title %></h1><% if(page.title==='分类'){ for(const [name,slug] of Object.entries(config.category_map)){ %><a class="indexitem" href="<%= url_for('categories/'+slug+'/') %>"><%= name %></a><% }}else{ site.tags.each(t=>{ %><a class="indexitem" href="<%= url_for(t.path) %>"># <%= t.name %></a><% })} %></section><%- partial('_partial/sidebar') %></div>
