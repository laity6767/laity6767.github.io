<% const p=site.data.profile, first=site.posts.sort('date',-1).first(); %><section class="hero"><div class="container heroin"><div class="eyebrow"><i></i><%= p.kicker %></div><h1><%= p.name %></h1><div class="english-name"><%= p.english %></div><p><%= p.intro %></p><% if(first){ %><a class="primary" href="<%= url_for(first.path) %>">阅读最新文章</a><% } %></div></section>
<div class="container columns"><section><div class="sectionhead"><h2><i></i>最新文章</h2></div><div class="tabs"><a class="selected" href="<%= url_for('/') %>">全部</a><% for(const [c,slug] of Object.entries(config.category_map)){ %><a href="<%= url_for('categories/'+slug+'/') %>"><%= c %></a><% } %></div><%- partial('_partial/list',{posts:page.posts}) %></section><%- partial('_partial/sidebar') %></div>
