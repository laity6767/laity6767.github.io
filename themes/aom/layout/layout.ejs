<% const p=site.data.profile; const title=page.title || (is_archive()?'文章归档':is_tag()?'# '+page.tag:is_category()?page.category:''); %>
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0c0f10"><meta name="description" content="<%= page.description || p.intro %>"><title><%= title?title+' · '+p.name:p.name %></title>
<link rel="icon" href="<%= url_for('assets/orbit.svg') %>">
<% for(const css of ['styles','motion','mobile','pages']){ %><link rel="stylesheet" href="<%= url_for(css+'.css') %>"><% } %>
</head><body><header class="topbar"><div class="container topinner"><a class="brand" href="<%= url_for('/') %>"><img alt="" src="<%= url_for('assets/orbit.svg') %>"><span class="wordmark"><b><%= p.name %></b><small lang="en"><%= p.english %></small></span></a>
<nav aria-label="主导航"><% for(const [label,path] of [['首页',''],['分类','categories/'],['归档','archives/'],['标签','tags/'],['关于','about/']]){ %><a href="<%= url_for(path||'/') %>" <% if((path && page.path.startsWith(path))||(!path && is_home())){ %>aria-current="page"<% } %>><%= label %></a><% } %></nav></div></header>
<main id="app"><%- body %></main><footer><div class="container foot"><a class="small-brand" href="<%= url_for('/') %>"><img src="<%= url_for('assets/orbit.svg') %>" alt=""><%= p.name %></a><a href="<%= url_for('about/') %>">关于本站</a></div></footer></body></html>
