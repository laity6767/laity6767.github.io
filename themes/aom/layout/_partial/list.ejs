<% posts.each(post=>{ const cover=({earth:'earth',server:'server',terminal:'server'})[post.cover]||'earth'; %><article class="postrow"><a class="thumb" href="<%= url_for(post.path) %>" aria-label="<%= post.title %>"><img loading="lazy" alt="" src="<%= url_for('assets/'+cover+'.webp') %>"></a><div class="postinfo"><div class="meta"><time><%= date(post.date,'YYYY.MM.DD') %></time><% post.categories.each(c=>{ %><b></b><a href="<%= url_for(c.path) %>"><%= c.name %></a><% }) %></div><h3><a href="<%= url_for(post.path) %>"><%= post.title %></a></h3><p><%= post.description %></p><div class="posttags"><% post.tags.each(t=>{ %><a class="tag" href="<%= url_for(t.path) %>"># <%= t.name %></a><% }) %></div></div></article><% }) %>
